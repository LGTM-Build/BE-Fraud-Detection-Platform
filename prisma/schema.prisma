// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum CompanyStatus {
  active   @map("Active")
  inactive @map("Inactive")
}

enum UserRole {
  super_admin     @map("Super Admin")
  super_user      @map("Super User")
  auditor         @map("Auditor")
  operator        @map("Operator")
  department_head @map("Department Head")
}

enum ReviewStatus {
  pending       @map("Pending")
  alert         @map("Alert")
  high_alert    @map("High Alert")
  auto_approved @map("Auto Approved")
  approved      @map("Approved")
  rejected      @map("Rejected")
}

enum SessionStatus {
  active
  revoked
}

enum VendorStatus {
  active      @map("Active")
  inactive    @map("Inactive")
  blacklisted @map("Blacklisted")
}

enum ProcurementMethod {
  pengadaan_langsung @map("Pengadaan Langsung")
  tender_terbuka     @map("Tender Terbuka")
  tender_tertutup    @map("tender Tertutup")
  e_purchasing       @map("E-Purchasing")
  rfp                @map("RFP")
  lainnya            @map("Lainnya")
}

enum FraudAnalysisType {
  supervised
  anomaly
}

enum FraudAnalysisStatus {
  pending
  processing
  completed
  failed
}

enum ExpenseCategory {
  entertainment @map("Entertainment")
  transport     @map("Transport")
  office_supply @map("Office Supply")
  meals         @map("Meals")
  vehicle       @map("Vehicle")
  training      @map("Training")
  others        @map("Others")
}

model Company {
  id            String        @id @default(uuid()) @db.Char(36)
  name          String        @db.VarChar(255)
  industry      String?       @db.VarChar(100)
  employeeCount Int?
  status        CompanyStatus @default(active)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  users                   User[]
  employees               Employee[]
  auditLogs               AuditLog[]
  sessions                UserSession[]
  vendors                 Vendor[]
  procurementTransactions ProcurementTransaction[]
  fraudAnalysisResults    FraudAnalysisResult[]
  expenses                Expense[]

  @@map("companies")
}

model User {
  id           String    @id @default(uuid()) @db.Char(36)
  companyId    String    @db.Char(36)
  employeeId   String?   @db.Char(36)
  fullName     String    @db.VarChar(255)
  email        String    @unique @db.VarChar(255)
  passwordHash String    @db.VarChar(255)
  role         UserRole
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company   Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee  Employee?     @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  sessions  UserSession[]
  auditLogs AuditLog[]

  createdProcurements ProcurementTransaction[] @relation("ProcurementCreatedBy")
  updatedProcurements ProcurementTransaction[] @relation("ProcurementUpdatedBy")

  createdExpenses Expense[] @relation("ExpenseCreatedBy")
  updatedExpenses Expense[] @relation("ExpenseUpdatedBy")

  @@index([companyId])
  @@index([employeeId])
  @@map("users")
}

model Employee {
  id                String   @id @default(uuid()) @db.Char(36)
  companyId         String   @db.Char(36)
  fullName          String   @db.VarChar(255)
  phoneNumber       String   @db.VarChar(50)
  department        String?  @db.VarChar(100)
  position          String?  @db.VarChar(100)
  externalRef       String?  @db.VarChar(100)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company                 Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users                   User[]
  procurementTransactions ProcurementTransaction[]
  expenses                Expense[]

  @@index([companyId])
  @@unique([companyId, externalRef])
  @@map("employees")
}

model UserSession {
  id               String        @id @default(uuid()) @db.Char(36)
  companyId        String        @db.Char(36)
  userId           String        @db.Char(36)
  refreshTokenHash String        @db.VarChar(255)
  ipAddress        String?       @db.VarChar(100)
  userAgent        String?       @db.VarChar(500)
  status           SessionStatus @default(active)
  lastUsedAt       DateTime?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([userId])
  @@map("user_sessions")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Char(36)
  companyId  String   @db.Char(36)
  userId     String   @db.Char(36)
  action     String   @db.VarChar(100)
  targetType String   @db.VarChar(50)
  targetId   String?  @db.Char(36)
  note       String?  @db.Text
  metadata   Json?
  createdAt  DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([userId])
  @@map("audit_logs")
}

model Vendor {
  id                     String       @id @default(uuid()) @db.Char(36)
  companyId              String       @db.Char(36)
  vendorName             String       @db.VarChar(255)
  metadata               Json?
  isActive               Boolean      @default(true)
  status                 VendorStatus @default(active)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  company                 Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, vendorName])
  @@index([companyId])
  @@map("vendors")
}

model ProcurementTransaction {
  id                String            @id @default(uuid()) @db.Char(36)
  companyId         String            @db.Char(36)
  employeeId        String?           @db.Char(36)

  purchaseId        String?           @db.VarChar(100)
  purchaseDate      DateTime
  vendorName        String            @db.VarChar(255)
  itemDescription   String            @db.Text
  department        String?           @db.VarChar(100)
  amountTotal       Decimal           @db.Decimal(15, 2)
  procurementMethod ProcurementMethod @default(lainnya)

  status            ReviewStatus      @default(pending)
  flags             Json?
  fraudScore        Float?
  aiExplanation     String?           @db.Text

  createdBy         String            @db.Char(36)
  updatedBy         String?           @db.Char(36)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  company           Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee          Employee?         @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  createdByUser     User              @relation("ProcurementCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedByUser     User?             @relation("ProcurementUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  fraudResults      FraudAnalysisResult[]

  @@index([companyId])
  @@index([employeeId])
  @@index([createdBy])
  @@index([updatedBy])
  @@index([status])
  @@index([purchaseDate])
  @@map("procurement_transactions")
}

model Expense {
  id            String          @id @default(uuid()) @db.Char(36)
  companyId     String          @db.Char(36)
  employeeId    String          @db.Char(36)

  expenseId     String?         @db.VarChar(100)
  expenseDate   DateTime
  description   String          @db.Text
  category      ExpenseCategory @default(others)
  merchant      String?         @db.VarChar(255)
  amountTotal   Decimal         @db.Decimal(15, 2)
  department    String?         @db.VarChar(100)

  status        ReviewStatus    @default(pending)
  flags         Json?
  fraudScore    Float?
  aiExplanation String?         @db.Text

  createdBy     String          @db.Char(36)
  updatedBy     String?         @db.Char(36)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  fraudResults  FraudAnalysisResult[]

  company       Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee      Employee        @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  createdByUser User            @relation("ExpenseCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedByUser User?           @relation("ExpenseUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([employeeId])
  @@index([createdBy])
  @@index([updatedBy])
  @@index([status])
  @@index([expenseDate])
  @@map("expenses")
}

model FraudAnalysisResult {
  id            String               @id @default(uuid()) @db.Char(36)
  companyId     String               @db.Char(36)
  procurementId String?              @db.Char(36)
  expenseId     String?              @db.Char(36)

  analysisType  FraudAnalysisType
  status        FraudAnalysisStatus  @default(pending)

  isFraud       Boolean?
  fraudScore    Float?
  flags         Json?
  aiExplanation String?              @db.Text
  features      Json?
  rawResponse   Json?

  requestedAt   DateTime?
  completedAt   DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  company       Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  procurement   ProcurementTransaction? @relation(fields: [procurementId], references: [id], onDelete: Cascade)
  expense       Expense?             @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([procurementId])
  @@index([expenseId])
  @@map("fraud_analysis_results")
}